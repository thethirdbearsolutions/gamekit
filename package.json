    "@types/node": "^22.0.0",
    "@types/three": "^0.186.0",
    "playwright-core": "~1.56.0",
    "three": "^0.186.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
